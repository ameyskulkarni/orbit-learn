# Copy to .env and fill in only the key(s) for the provider(s) you plan to use.
# LiteLLM chooses which env var to read based on the model prefix in config.yaml.

# --- Local Ollama (default in config.yaml) ---
# No API key needed. Ollama defaults to http://localhost:11434 — set this only if you
# run it on a different host or port.
# OLLAMA_API_BASE=http://localhost:11434

# --- Hosted providers (uncomment + fill in when switching the `model:` line) ---

# Anthropic — https://console.anthropic.com  (pay-as-you-go; NOT included in Claude Pro)
# ANTHROPIC_API_KEY=

# OpenAI — https://platform.openai.com
# OPENAI_API_KEY=

# Google Gemini — https://aistudio.google.com/app/apikey  (has a free tier)
# GEMINI_API_KEY=

# Groq — https://console.groq.com  (generous free tier)
# GROQ_API_KEY=

# --- Email delivery (Phase 4) ---
# Only needed if delivery.method is "email".
# ORBIT_EMAIL_PASSWORD=
